# Twitter/X cookie auth (required)
# Export cookies from browser using "EditThisCookie" extension or similar
# Save as cookies.json in project root
TWITTER_COOKIES_PATH=cookies.json

# OpenRouter (free models available)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat:free

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scoring threshold (0-100, accounts above this get sent)
SCORE_THRESHOLD=60

# Max accounts to process per run (avoid rate limits)
MAX_ACCOUNTS_PER_RUN=50

# GitHub (optional, increases rate limit from 60 to 5000/hr)
GITHUB_TOKEN=
